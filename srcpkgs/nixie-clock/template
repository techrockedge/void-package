# Template file for 'nixie-clock'
pkgname=nixie-clock
version=1.1.2
revision=1
build_style=gnu-makefile
hostmakedepends="vala pkg-config"
makedepends="gtk+3-devel cairo-devel"
short_desc="Lightweight desktop clock designed to look like a Nixie tube display"
maintainer="Sofiya <sofiya@v.com>"
license="MIT"
homepage="https://github.com"
distfiles="https://github.com/sofijacom/nixie-clock/archive/refs/tags/v${version}.tar.gz"
wrksrc="nixie-clock-v${version}"
checksum=ed3af01d3255bc7bbe197a8b2c2f8ab582b051d585975f8f38f88705e881953e

do_build() {
	# Compile Vala source into a standard C source file
	valac -C nixie_clock.vala --pkg gtk+-3.0 --pkg cairo

	# Compile the generated C file using Void's native, optimized compiler environment
	${CC} ${CFLAGS} nixie_clock.c -o nixie-clock $(pkg-config --cflags --libs gtk+-3.0 cairo) ${LDFLAGS} -lm
}

do_install() {
	vbin nixie-clock

	vmkdir usr/share/applications
	cat > ${DESTDIR}/usr/share/applications/nixie-clock.desktop <<EOF
[Desktop Entry]
Name=Nixie Clock
Comment=Sleek Desktop Nixie Tube Clock Widget
Exec=nixie-clock
Icon=preferences-system-time
Terminal=false
Type=Application
Categories=Utility;Clock;GTK;
EOF
}
